// =========================================================================
// 🆕 v5.3: FUNCIONES DE ALERTA MEJORADAS
// =========================================================================
// Alerta estándar (una por cierre de vela)
f_ia_alert(id, sym, msg) =>
    if barstate.isrealtime
        alert(id + " | " + sym + " | " + msg, alert.freq_once_per_bar_close)
    else
        log.info(id + " | " + msg)

// 🆕 v5.3: Alerta con frecuencia configurable (para PING usa freq_all)
f_ia_alert_freq(id, sym, msg, freq) =>
    if barstate.isrealtime
        alert(id + " | " + sym + " | " + msg, freq)
    else
        log.info(id + " | " + msg)

// Compact price formatting to avoid 4096-char alert limit
f_compact_price(float price) =>
    str.tostring(math.round_to_mintick(price))

// Short medal codes (keep substrings for JARVIS bot: God, CHoCH, Breaker)
f_short_medal(string medal) =>
    medal == "Platino" ? "PLAT" :
    medal == "Oro" ? "ORO" :
    medal == "Plata" ? "PLATA" :
    medal == "Bronce" ? "BRONCE" :
    medal == "CHoCH🚀" ? "CHoCH" :
    medal == "Breaker" ? "Breaker" :
    medal == "God Breaker" ? "God_Brk" :
    medal

// 🆕 v5.3: Safe JSON float — returns "null" for na values instead of "NaN"
f_json_float(float val) =>
    na(val) ? "null" : str.tostring(math.round_to_mintick(val))

// 🆕 v5.3: Safe JSON int — returns "null" for na values
f_json_int(int val) =>
    na(val) ? "null" : str.tostring(val)

// =========================================================================
// 3. 🧠 UDTs & FUNCIONES (Mejorados con scoring + mitigación parcial)
// =========================================================================
type ob_data
    float top
    float btm
    int   loc_time
    bool  is_bull
    int   score
    string medal
    bool  mitigated
    bool  partial_mitigated
    int   touch_count
    bool  hidden
    string level
    bool  alerted_touch      // 🆕 v5.3: flag para evitar alertas duplicadas de toque
    bool  has_displacement
    bool  has_fvg_after
    bool  is_choch_ob

type div_data
    float top
    float btm
    bool  is_bull
    int   bar_idx             // 🆕 v5.3: para incluir en SYNC_ZONES

type fvg_zone
    float top
    float btm
    int   idx
    bool  is_bull
    bool  is_inv
    bool  inv_retested
    box   bx
    bool  alerted

type liq_pool
    float y_val
    int x_start
    bool is_bull
    bool swept
    bool is_peh_pel
    line l
    label lbl

// --- Función de scoring unificado ---
f_score_zone(bool has_sweep, bool has_displacement, bool has_fvg, bool has_volume, bool has_vwap_align, bool has_htf_align, bool has_ifvg_overlap) =>
    int score = 0
    score += has_sweep         ? 2 : 0
    score += has_displacement  ? 2 : 0
    score += has_fvg           ? 1 : 0
    score += has_volume        ? 1 : 0
    score += has_vwap_align    ? 1 : 0
    score += has_htf_align     ? 2 : 0
    score += has_ifvg_overlap  ? 3 : 0
    score

f_score_to_medal(int score, bool is_choch) =>
    is_choch ? "CHoCH🚀" : score >= 9 ? "Platino" : score >= 7 ? "Oro" : score >= 5 ? "Plata" : "Bronce"

f_equal_levels(float lvl1, float lvl2, float tolerance_atr, float atr) =>
    math.abs(lvl1 - lvl2) <= atr * tolerance_atr

f_get_htf_trend() =>
    var int trend = 0
    var float last_h = na, var float last_l = na
    ph = ta.pivothigh(high, 3, 3), pl = ta.pivotlow(low, 3, 3)
    if not na(ph)
        last_h := ph
    if not na(pl)
        last_l := pl
    if not na(last_h) and close > last_h
        trend := 1
        last_h := na
        last_l := na
    if not na(last_l) and close < last_l
        trend := -1
        last_l := na
        last_h := na
    trend

f_format_delta(val) =>
    abs_val = math.abs(val)
    res = abs_val >= 1000000 ? str.tostring(val / 1000000, "#.##") + "M" : abs_val >= 1000 ? str.tostring(val / 1000, "#.##") + "K" : str.tostring(val)
    val > 0 ? "+" + res : res

htf1_val = request.security(syminfo.tickerid, "5", f_get_htf_trend())
htf2_val = request.security(syminfo.tickerid, "15", f_get_htf_trend())

var int macro_trend = 0
if barstate.isfirst or htf1_val != nz(htf1_val[1], htf1_val)
    macro_trend := htf1_val

float atr_global = ta.atr(14) 
bool in_kz = not use_kz or not na(time(timeframe.period, kz_lon, tz)) or not na(time(timeframe.period, kz_ny, tz)) or not na(time(timeframe.period, kz_nypm, tz))

// =========================================================================
// 3.5 🚀 MOTOR DE Z-SCORE
// =========================================================================
var float updist = 0.0
var float downdist = 0.0
updist   := close > open ? nz(updist[1]) + (close - open) : 0.0
downdist := close < open ? nz(downdist[1]) + (open - close) : 0.0

upMean  = ta.sma(updist, zLen)
upStdev = ta.stdev(updist, zLen)
dnMean  = ta.sma(downdist, zLen)
dnStdev = ta.stdev(downdist, zLen)

zUp = upStdev == 0.0 ? 0.0 : (updist - upMean) / upStdev
zDn = dnStdev == 0.0 ? 0.0 : (downdist - dnMean) / dnStdev

active_zThresh = not na(time(timeframe.period, kz_ny, tz)) ? zThresh_NY : zThresh

// =========================================================================
// 4. 🌊 VWAP INSTITUCIONAL & DELTA HTF
// =========================================================================
grp_vwap = "🌊 VWAP (Liquidez Promedio)"
show_vwap = input.bool(true, "Mostrar VWAP", group=grp_vwap)

bool vwap_anchor = timeframe.isdwm ? ta.change(time("M")) != 0 : (timeframe.period == "240" or timeframe.period == "60" ? ta.change(time("W")) != 0 : ta.change(time("D")) != 0)

var float sumSrcVol = 0.0
var float sumVol = 0.0
float cur_vol = nz(volume)

if vwap_anchor
    sumSrcVol := hlc3 * cur_vol
    sumVol := cur_vol
else
    sumSrcVol += hlc3 * cur_vol
    sumVol += cur_vol

vwap_val = sumVol == 0 ? hlc3 : sumSrcVol / sumVol
plot(show_vwap ? vwap_val : na, color=color.new(#2962ff, 40), title="VWAP Adaptativo", linewidth=2)
string vwap_status = close > vwap_val ? "OVER" : "UNDER"

new_1h_delta = ta.change(time("60"))
var float htf_delta = 0.0
var float htf_open = na

if new_1h_delta
    htf_delta := (close > open ? volume : close < open ? -volume : 0)
    htf_open := open
else
    htf_delta += (close > open ? volume : close < open ? -volume : 0)

bull_absorb = (close < htf_open) and (htf_delta > 0) 
bear_absorb = (close > htf_open) and (htf_delta < 0) 

// =========================================================================
// 4.5 🌙 RANGO ASIÁTICO
// =========================================================================
bool is_15m = timeframe.period == "15" or timeframe.period == "30"
bool in_asia = not na(time(timeframe.period, kz_asia, tz))
var float asia_h = na, var float asia_l = na
var float active_asia_h = na, var float active_asia_l = na
var line asia_line_h = na, var line asia_line_l = na, var label asia_lbl = na
var int asia_start_idx = na

if in_asia and not in_asia[1]
    asia_h := high, asia_l := low
    asia_start_idx := bar_index
else if in_asia
    asia_h := math.max(asia_h, high), asia_l := math.min(asia_l, low)
else if not in_asia and in_asia[1]
    active_asia_h := asia_h, active_asia_l := asia_l
    if show_asia and is_15m
        asia_line_h := line.new(asia_start_idx, active_asia_h, bar_index, active_asia_h, color=color.new(color.fuchsia, 40), style=line.style_dashed, width=2)
        asia_line_l := line.new(asia_start_idx, active_asia_l, bar_index, active_asia_l, color=color.new(color.fuchsia, 40), style=line.style_dashed, width=2)
        asia_lbl := label.new(math.round((asia_start_idx + bar_index)/2), active_asia_h, "Rango Asia", color=color(na), textcolor=color.fuchsia, style=label.style_label_down, size=size.tiny)

if not in_asia and show_asia
    if not na(asia_line_h)
        line.set_x2(asia_line_h, bar_index)
        line.set_x2(asia_line_l, bar_index)
        label.set_x(asia_lbl, bar_index)

// =========================================================================
// 5. 🧠 LECTURA MACRO Y TENDENCIA ACTIVA
// =========================================================================
[d_open, d_h_raw, d_l_raw, d_c_raw] = request.security(syminfo.tickerid, "D", [open[1], high[1], low[1], close[1]])
[m4h_h_raw, m4h_l_raw, m4h_c_raw] = request.security(syminfo.tickerid, "240", [high[1], low[1], close[1]])

var float active_d_h = na
var float active_d_l = na
bool new_D = ta.change(time("D")) != 0

if new_D or na(active_d_h)
    if na(active_d_h)
        active_d_h := d_h_raw
        active_d_l := d_l_raw
    else
        bool body_broke_up = d_c_raw > active_d_h
        bool body_broke_dn = d_c_raw < active_d_l
        bool engulfed = d_h_raw > active_d_h and d_l_raw < active_d_l
        if body_broke_up or body_broke_dn or engulfed
            active_d_h := d_h_raw
            active_d_l := d_l_raw

var float active_m4h_h = na
var float active_m4h_l = na
bool new_4H = ta.change(time("240")) != 0

if new_4H or na(active_m4h_h)
    if na(active_m4h_h)
        active_m4h_h := m4h_h_raw
        active_m4h_l := m4h_l_raw
    else
        bool body_broke_up = m4h_c_raw > active_m4h_h
        bool body_broke_dn = m4h_c_raw < active_m4h_l
        bool engulfed = m4h_h_raw > active_m4h_h and m4h_l_raw < active_m4h_l
        if body_broke_up or body_broke_dn or engulfed
            active_m4h_h := m4h_h_raw
            active_m4h_l := m4h_l_raw

float d_h = active_d_h
float d_l = active_d_l
float m4h_h = active_m4h_h
float m4h_l = active_m4h_l

var int crt_bias = 0
bool is_bias_off = bias_mode == "Desactivado (Mostrar Todos)"

if bias_mode == "Automático (Daily Open Direccional)"
    crt_bias := close > d_open ? 1 : (close < d_open ? -1 : 0)
else if bias_mode == "Manual Alcista 🟢"
    crt_bias := 1
else if bias_mode == "Manual Bajista 🔴"
    crt_bias := -1
else
    crt_bias := 0 

var int micro_trend = 0
int active_trend = override_choch ? (micro_trend != 0 ? micro_trend : macro_trend) : macro_trend

// Sweeps con detección estructural extendida (PEH/PEL)
var float last_swing_h = na, var float last_swing_l = na
swing_ph = ta.pivothigh(high, 5, 5)
swing_pl = ta.pivotlow(low, 5, 5)
if not na(swing_ph)
    last_swing_h := swing_ph
if not na(swing_pl)
    last_swing_l := swing_pl

bool sweep_dl_15m = low < d_l and close > d_l
bool sweep_dh_15m = high > d_h and close < d_h
bool sweep_m4l_15m = low < m4h_l and close > m4h_l
bool sweep_m4h_15m = high > m4h_h and close < m4h_h
bool sweep_asia_l = not na(active_asia_l) and low < active_asia_l and close > active_asia_l
bool sweep_asia_h = not na(active_asia_h) and high > active_asia_h and close < active_asia_h
bool sweep_swing_l = not na(last_swing_l) and low < last_swing_l and close > last_swing_l
bool sweep_swing_h = not na(last_swing_h) and high > last_swing_h and close < last_swing_h

float current_sweep_l = sweep_dl_15m ? d_l : sweep_m4l_15m ? m4h_l : sweep_asia_l ? active_asia_l : sweep_swing_l ? last_swing_l : na
float current_sweep_h = sweep_dh_15m ? d_h : sweep_m4h_15m ? m4h_h : sweep_asia_h ? active_asia_h : sweep_swing_h ? last_swing_h : na

// =========================================================================
// 5.5 🎯 ETIQUETAS CRT 3-VELAS (Modelo ICT Purist)
// =========================================================================
var float last_swept_h = na, var float last_swept_l = na
var bool sweep_bull_active = false, var bool sweep_bear_active = false
var float active_bear_sweep_high = na, var float active_bull_sweep_low = na

bool is_crt_bull_raw = not na(current_sweep_l) and (na(last_swept_l) or last_swept_l != current_sweep_l)
bool is_crt_bear_raw = not na(current_sweep_h) and (na(last_swept_h) or last_swept_h != current_sweep_h)

float prev_high = high[1]
float prev_low  = low[1]
bool close_inside_prev_bull = close >= prev_low and close <= prev_high
bool close_inside_prev_bear = close >= prev_low and close <= prev_high

bool is_crt_bull = is_crt_bull_raw and (not crt_3candle_model or not crt_close_inside or close_inside_prev_bull)
bool is_crt_bear = is_crt_bear_raw and (not crt_3candle_model or not crt_close_inside or close_inside_prev_bear)

var line tp_line_4h = na, var label tp_lbl_4h = na
var line tp_line_d = na, var label tp_lbl_d = na
var float tp_val_4h = na, var float tp_val_d = na
var int tp_dir = 0 

float body_top = math.max(open, close)
float body_btm = math.min(open, close)
float bull_wick = body_btm - low
float bear_wick = high - body_top
float total_range = high - low == 0 ? 1 : high - low
bool is_high_vol = volume > ta.sma(volume, 20) * vol_mult

int ny_h = hour(time, "America/New_York")
bool is_inst_kz = not na(time(timeframe.period, kz_lon, tz)) or not na(time(timeframe.period, kz_ny, tz)) or not na(time(timeframe.period, kz_nypm, tz))
string inst_tag = is_inst_kz ? " ⏰KZ" : ""

bool valid_bear_rej = close < open and (bear_wick / total_range >= 0.5)
bool valid_bull_rej = close > open and (bull_wick / total_range >= 0.5)
bool valid_crt_size = total_range >= (atr_global * crt_min_atr)
bool valid_inst_time = not crt_inst_only or is_inst_kz

// Temporizadores Anti-Spam Dinámicos
var int last_crt_bear_bar = -100
var int last_crt_bull_bar = -100
int cooldown_bars = timeframe.isintraday and timeframe.multiplier <= 5 ? 3 : 8
bool bear_cooldown = (bar_index - last_crt_bear_bar) > cooldown_bars 
bool bull_cooldown = (bar_index - last_crt_bull_bar) > cooldown_bars

if is_crt_bear and valid_bear_rej and valid_crt_size and valid_inst_time and bear_cooldown
    last_crt_bear_bar := bar_index
    if not sweep_bear_active 
        int eval_bias = crt_bias != 0 ? crt_bias : active_trend
        bool is_aligned = is_bias_off ? true : (eval_bias <= 0)
        bool allowed_to_sell = is_aligned or use_scalp
        bool bear_absorption = is_high_vol and (bear_wick / total_range > 0.5) 
        
        string final_lbl = bear_absorption ? "▼ CRT SELL + 🩸ABSORB" : "▼ CRT SELL"
        if sweep_asia_h
            final_lbl += " [ASIA]"
        if sweep_swing_h
            final_lbl += " [SWING]"
        final_lbl += inst_tag
        color lbl_col = is_aligned ? color.new(color.red, 40) : color.new(color.orange, 40)
        
        if showSweep and is_15m and in_kz
            label.new(bar_index, high, final_lbl, color=lbl_col, textcolor=color.black, style=label.style_label_down, size=size.small)
            if allowed_to_sell
                float eq_4h = (m4h_h + m4h_l) / 2
                float eq_d = (d_h + d_l) / 2
                
                line.delete(tp_line_4h)
                label.delete(tp_lbl_4h)
                line.delete(tp_line_d)
                label.delete(tp_lbl_d)
                tp_line_4h := line.new(bar_index, eq_4h, bar_index + 60, eq_4h, color=color.new(color.green, 20), style=line.style_dashed, width=1)
                tp_lbl_4h := label.new(bar_index + 60, eq_4h, "TP 50% 4H", color=color.new(color.black, 100), textcolor=color.green, style=label.style_label_left, size=size.tiny)
                tp_val_4h := eq_4h
                tp_line_d := line.new(bar_index, eq_d, bar_index + 60, eq_d, color=color.new(#2962ff, 20), style=line.style_dashed, width=1)
                tp_lbl_d := label.new(bar_index + 60, eq_d, "TP 50% Diario", color=color.new(color.black, 100), textcolor=#2962ff, style=label.style_label_left, size=size.tiny)
                tp_val_d := eq_d
                tp_dir := -1

        if alert_sweep and allowed_to_sell and is_15m and in_kz
            string abs_tag = bear_absorption ? " + ABSORCION" : ""
            string asia_tag = sweep_asia_h ? " + ASIA_SWEEP" : ""
            string swg_tag = sweep_swing_h ? " + SWING_SWEEP" : ""
            f_ia_alert("EVENTO_SWEEP", syminfo.ticker, "TF: " + timeframe.period + " | Dir: SELL | Nivel Reclamado" + abs_tag + asia_tag + swg_tag + inst_tag)
            
    sweep_bear_active := true
    active_bear_sweep_high := high 
    last_swept_h := current_sweep_h 

if is_crt_bull and valid_bull_rej and valid_crt_size and valid_inst_time and bull_cooldown
    last_crt_bull_bar := bar_index
    if not sweep_bull_active 
        int eval_bias = crt_bias != 0 ? crt_bias : active_trend
        bool is_aligned = is_bias_off ? true : (eval_bias >= 0)
        bool allowed_to_buy = is_aligned or use_scalp
        bool bull_absorption = is_high_vol and (bull_wick / total_range > 0.5) 
        
        string final_lbl = bull_absorption ? "▲ CRT BUY + 🟢ABSORB" : "▲ CRT BUY"
        if sweep_asia_l
            final_lbl += " [ASIA]"
        if sweep_swing_l
            final_lbl += " [SWING]"
        final_lbl += inst_tag
        color lbl_col = is_aligned ? color.new(color.green, 40) : color.new(color.orange, 40)
        
        if showSweep and is_15m and in_kz
            label.new(bar_index, low, final_lbl, color=lbl_col, textcolor=color.black, style=label.style_label_up, size=size.small)
            if allowed_to_buy
                float eq_4h = (m4h_h + m4h_l) / 2
                float eq_d = (d_h + d_l) / 2
                
                line.delete(tp_line_4h)
                label.delete(tp_lbl_4h)
                line.delete(tp_line_d)
                label.delete(tp_lbl_d)
                tp_line_4h := line.new(bar_index, eq_4h, bar_index + 60, eq_4h, color=color.new(color.red, 20), style=line.style_dashed, width=1)
                tp_lbl_4h := label.new(bar_index + 60, eq_4h, "TP 50% 4H", color=color.new(color.black, 100), textcolor=color.red, style=label.style_label_left, size=size.tiny)
                tp_val_4h := eq_4h
                tp_line_d := line.new(bar_index, eq_d, bar_index + 60, eq_d, color=color.new(#2962ff, 20), style=line.style_dashed, width=1)
                tp_lbl_d := label.new(bar_index + 60, eq_d, "TP 50% Diario", color=color.new(color.black, 100), textcolor=#2962ff, style=label.style_label_left, size=size.tiny)
                tp_val_d := eq_d
                tp_dir := 1 

        if alert_sweep and allowed_to_buy and is_15m and in_kz
            string abs_tag = bull_absorption ? " + ABSORCION" : ""
            string asia_tag = sweep_asia_l ? " + ASIA_SWEEP" : ""
            string swg_tag = sweep_swing_l ? " + SWING_SWEEP" : ""
            f_ia_alert("EVENTO_SWEEP", syminfo.ticker, "TF: " + timeframe.period + " | Dir: BUY | Nivel Reclamado" + abs_tag + asia_tag + swg_tag + inst_tag)
            
    sweep_bull_active := true
    active_bull_sweep_low := low
    last_swept_l := current_sweep_l

// Gestión de TP
if tp_dir == 1 
    if not na(tp_val_4h) and high >= tp_val_4h 
        line.delete(tp_line_4h)
        label.delete(tp_lbl_4h)
        tp_val_4h := na
    if not na(tp_val_d) and high >= tp_val_d 
        line.delete(tp_line_d)
        label.delete(tp_lbl_d)
        tp_val_d := na
if tp_dir == -1 
    if not na(tp_val_4h) and low <= tp_val_4h 
        line.delete(tp_line_4h)
        label.delete(tp_lbl_4h)
        tp_val_4h := na
    if not na(tp_val_d) and low <= tp_val_d 
        line.delete(tp_line_d)
        label.delete(tp_lbl_d)
        tp_val_d := na

if sweep_bear_active
    if close > active_bear_sweep_high 
        sweep_bear_active := false
        active_bear_sweep_high := na
        f_ia_alert("SWEEP_BROKEN", syminfo.ticker, "TF: " + timeframe.period + " | Dir: SELL")
    else if high > active_bear_sweep_high 
        active_bear_sweep_high := high 

if sweep_bull_active
    if close < active_bull_sweep_low 
        sweep_bull_active := false
        active_bull_sweep_low := na
        f_ia_alert("SWEEP_BROKEN", syminfo.ticker, "TF: " + timeframe.period + " | Dir: BUY")
    else if low < active_bull_sweep_low 
        active_bull_sweep_low := low

// =========================================================================
// 6. 🎯 MOTOR FVG / iFVG (Ahora con visualización de FVG estándar)
// =========================================================================
var array<fvg_zone> fvgs = array.new<fvg_zone>()

float fvg_body_pct = math.abs(open[1] - close[1]) / math.max(high[1] - low[1], syminfo.mintick)

bool valid_bull_fvg = low[0] > high[2] and close[1] > open[1] and (low[0] - high[2]) > (atr_global * fvg_min_atr) and (low[0] - high[2]) <= (atr_global * fvg_max_atr) and fvg_body_pct >= fvg_exp_req
bool valid_bear_fvg = high[0] < low[2] and close[1] < open[1] and (low[2] - high[0]) > (atr_global * fvg_min_atr) and (low[2] - high[0]) <= (atr_global * fvg_max_atr) and fvg_body_pct >= fvg_exp_req

if valid_bull_fvg and barstate.isconfirmed
    box bx = show_fvg ? box.new(bar_index[2], low[0], bar_index, high[2], bgcolor=color.new(#089981, 85), border_color=color.new(#089981, 50), border_style=line.style_dashed, text="FVG", text_size=size.tiny, text_color=color.new(#089981, 50)) : box(na)
    array.unshift(fvgs, fvg_zone.new(low[0], high[2], bar_index[2], true, false, false, bx, false))

if valid_bear_fvg and barstate.isconfirmed
    box bx = show_fvg ? box.new(bar_index[2], low[2], bar_index, high[0], bgcolor=color.new(#f23645, 85), border_color=color.new(#f23645, 50), border_style=line.style_dashed, text="FVG", text_size=size.tiny, text_color=color.new(#f23645, 50)) : box(na)
    array.unshift(fvgs, fvg_zone.new(low[2], high[0], bar_index[2], false, false, false, bx, false))

float curr_body = math.abs(close - open)
float curr_range_safe = math.max(high - low, syminfo.mintick)
bool body_strong = (curr_body / curr_range_safe) >= ifvg_body_inv

if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        fz = array.get(fvgs, i)
        
        if not na(fz.bx)
            box.set_right(fz.bx, bar_index)

        if not fz.is_inv
            if fz.is_bull
                if close < fz.btm and body_strong
                    float fvg_size = math.abs(fz.top - fz.btm)
                    if fvg_size >= (atr_global * ifvg_min_atr)
                        fz.is_inv := true
                        bool is_aligned = is_bias_off ? true : (active_trend <= 0 or crt_bias <= 0)
                        if showIfvg
                            color c_bd = color.new(color.orange, 40)
                            color bg_c = is_aligned ? color.new(color.orange, 90) : color.new(color.orange, 100)
                            if na(fz.bx)
                                fz.bx := box.new(fz.idx, fz.top, bar_index, fz.btm, bgcolor=bg_c, border_color=c_bd, border_style=line.style_dotted, text="iFVG↘", text_color=c_bd, text_size=size.tiny)
                            else
                                box.set_bgcolor(fz.bx, bg_c)
                                box.set_border_color(fz.bx, c_bd)
                                box.set_text(fz.bx, "iFVG↘")
                                box.set_text_color(fz.bx, c_bd)
                        else
                            if not na(fz.bx)
                                box.delete(fz.bx)
                                fz.bx := box(na)
                    else
                        if not na(fz.bx)
                            box.delete(fz.bx)
                        array.remove(fvgs, i)
                else if low <= fz.btm 
                    if not na(fz.bx)
                        box.delete(fz.bx)
                    array.remove(fvgs, i)
                else if low < fz.top 
                    fz.top := math.max(low, fz.btm) 
                    if not na(fz.bx)
                        box.set_top(fz.bx, fz.top)
            else
                if close > fz.top and body_strong
                    float fvg_size = math.abs(fz.top - fz.btm)
                    if fvg_size >= (atr_global * ifvg_min_atr) 
                        fz.is_inv := true
                        bool is_aligned = is_bias_off ? true : (active_trend >= 0 or crt_bias >= 0)
                        if showIfvg
                            color c_bd = color.new(#089981, 40)
                            color bg_c = is_aligned ? color.new(#089981, 90) : color.new(#089981, 100)
                            if na(fz.bx)
                                fz.bx := box.new(fz.idx, fz.top, bar_index, fz.btm, bgcolor=bg_c, border_color=c_bd, border_style=line.style_dotted, text="iFVG↗", text_color=c_bd, text_size=size.tiny)
                            else
                                box.set_bgcolor(fz.bx, bg_c)
                                box.set_border_color(fz.bx, c_bd)
                                box.set_text(fz.bx, "iFVG↗")
                                box.set_text_color(fz.bx, c_bd)
                        else
                            if not na(fz.bx)
                                box.delete(fz.bx)
                                fz.bx := box(na)
                    else
                        if not na(fz.bx)
                            box.delete(fz.bx)
                        array.remove(fvgs, i)
                else if high >= fz.top 
                    if not na(fz.bx)
                        box.delete(fz.bx)
                    array.remove(fvgs, i)
                else if high > fz.btm 
                    fz.btm := math.min(high, fz.top)
                    if not na(fz.bx)
                        box.set_bottom(fz.bx, fz.btm)
        else
            bool eff_bull_now = not fz.is_bull
            bool touching = high >= fz.btm and low <= fz.top
            if touching and not fz.inv_retested
                fz.inv_retested := true
            
            bool fully_broken = (eff_bull_now and close < fz.btm and body_strong) or (not eff_bull_now and close > fz.top and body_strong)
            if fully_broken
                if not na(fz.bx)
                    box.delete(fz.bx)
                array.remove(fvgs, i)

while array.size(fvgs) > 50
    del = array.pop(fvgs)
    if not na(del.bx)
        box.delete(del.bx)

f_ob_has_god_fvg(float ob_top, float ob_btm, bool ob_is_bull) =>
    bool result = false
    if array.size(fvgs) > 0
        for j = 0 to array.size(fvgs) - 1
            fz = array.get(fvgs, j)
            if fz.is_inv
                bool eff_bull = not fz.is_bull
                bool retest_ok = not require_ifvg_retest or fz.inv_retested
                if eff_bull == ob_is_bull and retest_ok and not (ob_top < fz.btm or ob_btm > fz.top)
                    result := true
                    break
    result

// =========================================================================
// 7. ⚡ RSI DIVERGENCIAS
// =========================================================================
var array<div_data> active_divs = array.new<div_data>()
if use_rsi
    rsi_val = ta.rsi(close, rsi_len)
    ph_rsi = ta.pivothigh(high, 2, 2), pl_rsi = ta.pivotlow(low, 2, 2)
    var float last_ph_price = na, var float last_ph_rsi = na, var float last_pl_price = na, var float last_pl_rsi = na

    if not na(ph_rsi)
        if not na(last_ph_price) and high[2] > last_ph_price and rsi_val[2] < last_ph_rsi and rsi_val[2] > (100 - rsi_ext - 10)
            if not na(current_sweep_h[2]) or high[2] >= d_h or high[2] >= m4h_h or high[2] >= active_asia_h
                array.unshift(active_divs, div_data.new(high[2], math.min(open[2], close[2]), false, bar_index[2]))
                if show_div_lbl
                    label.new(bar_index[2], high[2], "💎 SMC DIV SELL", color=color.new(color.black, 100), textcolor=color.red, style=label.style_label_down, size=size.tiny)
                if alert_div and in_kz
                    f_ia_alert("EVENTO_SMC_DIV", syminfo.ticker, "TF: " + timeframe.period + " | Dir: SELL | Tipo: Agotamiento + Sweep")
        last_ph_price := high[2], last_ph_rsi := rsi_val[2]

    if not na(pl_rsi)
        if not na(last_pl_price) and low[2] < last_pl_price and rsi_val[2] > last_pl_rsi and rsi_val[2] < (rsi_ext + 10)
            if not na(current_sweep_l[2]) or low[2] <= d_l or low[2] <= m4h_l or low[2] <= active_asia_l
                array.unshift(active_divs, div_data.new(math.max(open[2], close[2]), low[2], true, bar_index[2]))
                if show_div_lbl
                    label.new(bar_index[2], low[2], "💎 SMC DIV BUY", color=color.new(color.black, 100), textcolor=color.green, style=label.style_label_up, size=size.tiny)
                if alert_div and in_kz
                    f_ia_alert("EVENTO_SMC_DIV", syminfo.ticker, "TF: " + timeframe.period + " | Dir: BUY | Tipo: Agotamiento + Sweep")
        last_pl_price := low[2], last_pl_rsi := rsi_val[2]

    if array.size(active_divs) > 0
        for i = array.size(active_divs) - 1 to 0
            div = array.get(active_divs, i)
            bool is_broken = false
            if div.is_bull and close < div.btm
                is_broken := true
            else if not div.is_bull and close > div.top
                is_broken := true
            if is_broken
                if in_kz
                    f_ia_alert("DIV_BROKEN", syminfo.ticker, "TF: " + timeframe.period + " | Dir: " + (div.is_bull ? "BUY" : "SELL"))
                array.remove(active_divs, i)

// =========================================================================
// 8. 📐 ESTRUCTURA Y LIQUIDEZ (PEH/PEL detection)
// =========================================================================
smc_ph = ta.pivothigh(high, str_bars, str_bars), smc_pl = ta.pivotlow(low, str_bars, str_bars)
var float curr_ph = na, var int curr_ph_idx = na
var float curr_pl = na, var int curr_pl_idx = na

var float last_liq_ph = na, var int last_liq_ph_idx = na
var float last_liq_pl = na, var int last_liq_pl_idx = na
var array<liq_pool> active_pools = array.new<liq_pool>()

if not na(smc_ph)
    curr_ph := smc_ph, curr_ph_idx := bar_index[str_bars]
    if not na(last_liq_ph) and math.abs(curr_ph - last_liq_ph) <= (atr_global * liq_sens)
        bool is_peh = f_equal_levels(curr_ph, last_liq_ph, peh_pel_tol, atr_global)
        if show_liq
            color liq_col = is_peh ? color.new(color.fuchsia, 20) : color.new(color.red, 30)
            string liq_txt = is_peh ? "$$$ PEH" : "$$$ LIQ"
            line l = line.new(last_liq_ph_idx, math.max(curr_ph, last_liq_ph), curr_ph_idx, math.max(curr_ph, last_liq_ph), color=liq_col, style=line.style_dashed, width=1)
            label lbl = label.new(curr_ph_idx, math.max(curr_ph, last_liq_ph), liq_txt, color=color(na), textcolor=is_peh ? color.fuchsia : color.red, style=label.style_label_down, size=size.tiny)
            array.push(active_pools, liq_pool.new(math.max(curr_ph, last_liq_ph), curr_ph_idx, false, false, is_peh, l, lbl))
    last_liq_ph := curr_ph, last_liq_ph_idx := curr_ph_idx

if not na(smc_pl)
    curr_pl := smc_pl, curr_pl_idx := bar_index[str_bars]
    if not na(last_liq_pl) and math.abs(curr_pl - last_liq_pl) <= (atr_global * liq_sens)
        bool is_pel = f_equal_levels(curr_pl, last_liq_pl, peh_pel_tol, atr_global)
        if show_liq
            color liq_col = is_pel ? color.new(color.fuchsia, 20) : color.new(color.blue, 30)
            string liq_txt = is_pel ? "$$$ PEL" : "$$$ LIQ"
            line l = line.new(last_liq_pl_idx, math.min(curr_pl, last_liq_pl), curr_pl_idx, math.min(curr_pl, last_liq_pl), color=liq_col, style=line.style_dashed, width=1)
            label lbl = label.new(curr_pl_idx, math.min(curr_pl, last_liq_pl), liq_txt, color=color(na), textcolor=is_pel ? color.fuchsia : color.blue, style=label.style_label_up, size=size.tiny)
            array.push(active_pools, liq_pool.new(math.min(curr_pl, last_liq_pl), curr_pl_idx, true, false, is_pel, l, lbl))
    last_liq_pl := curr_pl, last_liq_pl_idx := curr_pl_idx

if array.size(active_pools) > 0
    for i = array.size(active_pools) - 1 to 0
        pool = array.get(active_pools, i)
        line.set_x2(pool.l, bar_index)
        label.set_x(pool.lbl, bar_index)
        if (pool.is_bull and low < pool.y_val) or (not pool.is_bull and high > pool.y_val)
            line.delete(pool.l)
            label.delete(pool.lbl)
            array.remove(active_pools, i)
        else
            if bar_index - pool.x_start > 200
                line.delete(pool.l)
                label.delete(pool.lbl)
                array.remove(active_pools, i)

// =========================================================================
// 8.5 📉 TRENDLINE LIQUIDITY (TRAMPAS RETAIL)
// =========================================================================
type tl_data
    bool is_bull
    line l
    label lbl
    float m
    float b
    int end_idx
    bool swept

grp_tl = "📉 Trendline Liquidity ($$$)"
show_tl = input.bool(true, "Mostrar Líneas de Tendencia (Retail Liq)", group=grp_tl)
tl_tol = input.float(0.4, "Tolerancia Rectitud (x ATR)", step=0.1, group=grp_tl)
in_alert_tl = input.bool(true, "Alerta: Sweep de Trendline", group=grp_tl)
tl_require_kz = input.bool(false, "Solo en Killzones (TL Swp)", group=grp_tl)
alert_tl = preset_3m ? false : preset_15m ? true : preset_1h ? true : preset_4h ? false : in_alert_tl

int tl_max_bars = preset_3m ? 300 : preset_15m ? 200 : preset_1h ? 150 : preset_4h ? 100 : 150

var float pl1 = na, var int pl1_idx = na
var float pl2 = na, var int pl2_idx = na
var float pl3 = na, var int pl3_idx = na

var float ph1 = na, var int ph1_idx = na
var float ph2 = na, var int ph2_idx = na
var float ph3 = na, var int ph3_idx = na

var array<tl_data> active_tls = array.new<tl_data>()

// --- DETECCIÓN DE RESISTENCIA RETAIL (Lower Highs + Double Tops) ---
if not na(smc_ph)
    ph3 := ph2, ph3_idx := ph2_idx
    ph2 := ph1, ph2_idx := ph1_idx
    ph1 := curr_ph, ph1_idx := curr_ph_idx

    if not na(ph3) and show_tl
        if ph1 < ph2 and ph2 < ph3
            float m1 = (ph2 - ph3) / math.max(1, ph2_idx - ph3_idx)
            float proj_ph1 = ph2 + m1 * (ph1_idx - ph2_idx)
            
            if math.abs(ph1 - proj_ph1) <= (atr_global * tl_tol)
                float m_avg = (ph1 - ph3) / math.max(1, ph1_idx - ph3_idx)
                float b_y = ph1 - m_avg * ph1_idx
                line l = line.new(ph3_idx, ph3, bar_index, m_avg * bar_index + b_y, color=color.new(color.red, 30), style=line.style_dashed, width=2)
                label lbl = label.new(ph1_idx, ph1, "$$$ TL LIQ", color=color(na), textcolor=color.red, style=label.style_label_down, size=size.tiny)
                array.push(active_tls, tl_data.new(false, l, lbl, m_avg, b_y, bar_index, false))
        
        else if math.abs(ph1 - ph2) <= (atr_global * tl_tol) and ph2 < ph3
            float m_avg = (ph1 - ph3) / math.max(1, ph1_idx - ph3_idx)
            float b_y = ph1 - m_avg * ph1_idx
            float top_level = math.max(ph1, ph2)
            line l = line.new(ph3_idx, ph3, bar_index, m_avg * bar_index + b_y, color=color.new(color.red, 40), style=line.style_dashed, width=3)
            label lbl = label.new(ph1_idx, top_level, "$$$ DBL TOP", color=color(na), textcolor=color.maroon, style=label.style_label_down, size=size.tiny)
            array.push(active_tls, tl_data.new(false, l, lbl, m_avg, b_y, bar_index, false))

// --- DETECCIÓN DE SOPORTE RETAIL (Higher Lows + Double Bottoms) ---
if not na(smc_pl)
    pl3 := pl2, pl3_idx := pl2_idx
    pl2 := pl1, pl2_idx := pl1_idx
    pl1 := curr_pl, pl1_idx := curr_pl_idx

    if not na(pl3) and show_tl
        if pl1 > pl2 and pl2 > pl3
            float m1 = (pl2 - pl3) / math.max(1, pl2_idx - pl3_idx)
            float proj_pl1 = pl2 + m1 * (pl1_idx - pl2_idx)
            
            if math.abs(pl1 - proj_pl1) <= (atr_global * tl_tol)
                float m_avg = (pl1 - pl3) / math.max(1, pl1_idx - pl3_idx)
                float b_y = pl1 - m_avg * pl1_idx
                line l = line.new(pl3_idx, pl3, bar_index, m_avg * bar_index + b_y, color=color.new(#089981, 30), style=line.style_dashed, width=2)
                label lbl = label.new(pl1_idx, pl1, "$$$ TL LIQ", color=color(na), textcolor=#089981, style=label.style_label_up, size=size.tiny)
                array.push(active_tls, tl_data.new(true, l, lbl, m_avg, b_y, bar_index, false))
        
        else if math.abs(pl1 - pl2) <= (atr_global * tl_tol) and pl2 > pl3
            float m_avg = (pl1 - pl3) / math.max(1, pl1_idx - pl3_idx)
            float b_y = pl1 - m_avg * pl1_idx
            float bot_level = math.min(pl1, pl2)
            line l = line.new(pl3_idx, pl3, bar_index, m_avg * bar_index + b_y, color=color.new(#056656, 40), style=line.style_dashed, width=3)
            label lbl = label.new(pl1_idx, bot_level, "$$$ DBL BOT", color=color(na), textcolor=#056656, style=label.style_label_up, size=size.tiny)
            array.push(active_tls, tl_data.new(true, l, lbl, m_avg, b_y, bar_index, false))

// --- GESTIÓN DE TRAMPAS (Extensión y Ruptura) ---
if array.size(active_tls) > 0
    for i = array.size(active_tls) - 1 to 0
        t = array.get(active_tls, i)
        float current_tl_price = t.m * bar_index + t.b
        
        line.set_x2(t.l, bar_index)
        line.set_y2(t.l, current_tl_price)

        bool is_broken = false
        if t.is_bull and low < current_tl_price
            is_broken := true
        else if not t.is_bull and high > current_tl_price
            is_broken := true

        if is_broken
            if not t.swept
                bool has_break_vol = volume > ta.sma(volume, 20) * vol_mult or (t.is_bull ? zDn >= active_zThresh : zUp >= active_zThresh)
                bool kz_ok = not tl_require_kz or in_kz
                if alert_tl and kz_ok and has_break_vol
                    f_ia_alert("EVENTO_SWEEP_TL", syminfo.ticker, "TF: " + timeframe.period + " | Dir: " + (t.is_bull ? "SELL" : "BUY") + " | Tipo: Trendline Sweep")
                
                label.set_text(t.lbl, "🩸 TL SWEPT")
                label.set_textcolor(t.lbl, color.new(color.gray, 40))
                line.set_color(t.l, color.new(color.gray, 70))
                t.swept := true
            
        if bar_index - t.end_idx > tl_max_bars
            line.delete(t.l)
            label.delete(t.lbl)
            array.remove(active_tls, i)

// =========================================================================
// 9. 🏛️ MOTOR SMC PURISTA (BOS / CHOCH Y SCORING MATEMÁTICO)
// =========================================================================
var all_obs = array.new<ob_data>(0)
var breaker_obs = array.new<ob_data>(0)
var box[] ob_boxes_drawn = array.new_box()

var float trend_extreme = na
if micro_trend == 1
    trend_extreme := na(trend_extreme) ? high : math.max(trend_extreme, high)
else if micro_trend == -1
    trend_extreme := na(trend_extreme) ? low : math.min(trend_extreme, low)

if showBos
    // =====================================================================
    // 🟢 ESTRUCTURA ALCISTA (BOS / CHoCH BUY)
    // =====================================================================
    if not na(curr_ph) and close > curr_ph 
        bool is_choch = (micro_trend == -1 or micro_trend == 0) 
        bool has_mom = zUp >= active_zThresh 
        
        int lookback = math.max(5, math.min(nz(bar_index - curr_ph_idx) + 15, 300))
        int origin_idx = 1
        float min_low = low[1]
        for i = 1 to lookback
            if low[i] < min_low
                min_low := low[i]
                origin_idx := i

        bool swept_extreme = na(trend_extreme) or (min_low <= trend_extreme)
        bool swept_liq = swept_extreme or sweep_bull_active
        bool pass_sweep = not is_choch or not choch_req_sweep or swept_liq
        bool pass_mom   = not is_choch or not choch_req_mom or has_mom

        if pass_sweep and pass_mom
            micro_trend := 1 
            trend_extreme := high 
            
            // 🆕 v5.3: Diferenciar CHoCH vs BOS en label y alerta
            string event_prefix = is_choch ? "EVENTO_CHOCH" : "EVENTO_BOS"
            string lbl_txt = is_choch ? (has_mom ? "CHoCH 🚀+MOM" : "CHoCH 🚀") : (has_mom ? "BOS +MOM" : "BOS")
            line.new(curr_ph_idx, curr_ph, bar_index, curr_ph, color=color.new(#089981, 0), style=line.style_dotted, width=1)
            label.new(bar_index, curr_ph, lbl_txt, color=color.new(color.black, 100), textcolor=#089981, style=label.style_label_lower_right, size=size.tiny)
            
            if alert_choch and in_kz
                f_ia_alert(event_prefix, syminfo.ticker, "TF: " + timeframe.period + " | Dir: BUY | VWAP: " + vwap_status + " | ORIGIN: " + str.tostring(trend_extreme))
            
            int ob_cand_idx = origin_idx
            for i = origin_idx to math.min(origin_idx + 5, 300)
                if close[i] < open[i] 
                    ob_cand_idx := i
                    break
            
            bool has_fvg_near = false
            int limit_idx_bull = math.max(1, ob_cand_idx - 3)
            if (ob_cand_idx - 1) >= limit_idx_bull
                for i = limit_idx_bull to (ob_cand_idx - 1)
                    if low[i-1] > high[i+1] and (low[i-1] - high[i+1]) > (atr_global * fvg_min_atr)
                        has_fvg_near := true
                        break
            
            float ob_range = high[ob_cand_idx] - low[ob_cand_idx]
            float ob_body  = math.abs(open[ob_cand_idx] - close[ob_cand_idx])
            bool valid_body = (ob_body / math.max(ob_range, syminfo.mintick)) >= ob_min_body
            
            bool swp = low[origin_idx] < low[origin_idx+1] and low[origin_idx] < low[origin_idx+2]
            bool passes_strict_sweep = not strictSweep or swp
            bool valid_bos_break = (high - low) > (atr_global * displ_atr_mult) or has_mom

            if passes_strict_sweep and valid_bos_break and (not require_fvg_after_ob or has_fvg_near) and valid_body
                float ob_top = useBodyOB ? math.max(open[ob_cand_idx], close[ob_cand_idx]) : high[ob_cand_idx]
                float ob_btm = low[ob_cand_idx]
                
                bool is_discount = (hl2[1] < vwap_val[1])
                bool htf_aligned = (htf2_val == 1)
                bool has_vol = zUp >= active_zThresh or (volume[ob_cand_idx] > ta.sma(volume, 20)[ob_cand_idx] * vol_mult)
                bool god_overlap = f_ob_has_god_fvg(ob_top, ob_btm, true)
                
                int ob_score = f_score_zone(swp, true, has_fvg_near, has_vol, is_discount, htf_aligned, god_overlap)
                string ob_medal = f_score_to_medal(ob_score, is_choch)
                
                all_obs.unshift(ob_data.new(ob_top, ob_btm, time[ob_cand_idx], true, ob_score, ob_medal, false, false, 0, false, str.tostring(math.round(ob_top, 5)), false, true, has_fvg_near, is_choch))

        curr_ph := na

    // =====================================================================
    // 🔴 ESTRUCTURA BAJISTA (BOS / CHoCH SELL)
    // =====================================================================
    if not na(curr_pl) and close < curr_pl 
        bool is_choch = (micro_trend == 1 or micro_trend == 0) 
        bool has_mom = zDn >= active_zThresh 
        
        int lookback = math.max(5, math.min(nz(bar_index - curr_pl_idx) + 15, 300))
        int origin_idx = 1
        float max_high = high[1]
        for i = 1 to lookback
            if high[i] > max_high
                max_high := high[i]
                origin_idx := i

        bool swept_extreme = na(trend_extreme) or (max_high >= trend_extreme)
        bool swept_liq = swept_extreme or sweep_bear_active
        bool pass_sweep = not is_choch or not choch_req_sweep or swept_liq
        bool pass_mom   = not is_choch or not choch_req_mom or has_mom

        if pass_sweep and pass_mom
            micro_trend := -1 
            trend_extreme := low 
            
            // 🆕 v5.3: Diferenciar CHoCH vs BOS en label y alerta
            string event_prefix = is_choch ? "EVENTO_CHOCH" : "EVENTO_BOS"
            string lbl_txt = is_choch ? (has_mom ? "CHoCH 🚀+MOM" : "CHoCH 🚀") : (has_mom ? "BOS +MOM" : "BOS")
            line.new(curr_pl_idx, curr_pl, bar_index, curr_pl, color=color.new(#f23645, 0), style=line.style_dotted, width=1)
            label.new(bar_index, curr_pl, lbl_txt, color=color.new(color.black, 100), textcolor=#f23645, style=label.style_label_upper_right, size=size.tiny)
            
            if alert_choch and in_kz
                f_ia_alert(event_prefix, syminfo.ticker, "TF: " + timeframe.period + " | Dir: SELL | VWAP: " + vwap_status + " | ORIGIN: " + str.tostring(trend_extreme))
            
            int ob_cand_idx = origin_idx
            for i = origin_idx to math.min(origin_idx + 5, 300)
                if close[i] > open[i] 
                    ob_cand_idx := i
                    break
            
            bool has_fvg_near = false
            int limit_idx_bear = math.max(1, ob_cand_idx - 3)
            if (ob_cand_idx - 1) >= limit_idx_bear
                for i = limit_idx_bear to (ob_cand_idx - 1)
                    if high[i-1] < low[i+1] and (low[i+1] - high[i-1]) > (atr_global * fvg_min_atr)
                        has_fvg_near := true
                        break
                    
            float ob_range = high[ob_cand_idx] - low[ob_cand_idx]
            float ob_body  = math.abs(open[ob_cand_idx] - close[ob_cand_idx])
            bool valid_body = (ob_body / math.max(ob_range, syminfo.mintick)) >= ob_min_body
            
            bool swp = high[origin_idx] > high[origin_idx+1] and high[origin_idx] > high[origin_idx+2]
            bool passes_strict_sweep = not strictSweep or swp
            bool valid_bos_break = (high - low) > (atr_global * displ_atr_mult) or has_mom

            if passes_strict_sweep and valid_bos_break and (not require_fvg_after_ob or has_fvg_near) and valid_body
                float ob_top = high[ob_cand_idx]
                float ob_btm = useBodyOB ? math.min(open[ob_cand_idx], close[ob_cand_idx]) : low[ob_cand_idx]
                
                bool is_premium = (hl2[1] > vwap_val[1])
                bool htf_aligned = (htf2_val == -1)
                bool has_vol = zDn >= active_zThresh or (volume[ob_cand_idx] > ta.sma(volume, 20)[ob_cand_idx] * vol_mult)
                bool god_overlap = f_ob_has_god_fvg(ob_top, ob_btm, false)
                
                int ob_score = f_score_zone(swp, true, has_fvg_near, has_vol, is_premium, htf_aligned, god_overlap)
                string ob_medal = f_score_to_medal(ob_score, is_choch)
                    
                all_obs.unshift(ob_data.new(ob_top, ob_btm, time[ob_cand_idx], false, ob_score, ob_medal, false, false, 0, false, str.tostring(math.round(ob_btm, 5)), false, true, has_fvg_near, is_choch))

        curr_pl := na

// =========================================================================
// 🚀 INYECCIÓN: MOTOR SCALPING LEGACY 4.7 (BÚSQUEDA INVERSA + VWAP)
// =========================================================================
if use_inv_motor and barstate.isconfirmed
    // --- BÚSQUEDA INVERSA ALCISTA ---
    if low[0] > high[2] and close[1] > open[1] and (low[0] - high[2]) > (atr_global * fvg_min_atr)
        bool has_mom = zUp[1] >= active_zThresh[1] or nz(volume[1]) > nz(ta.sma(volume, 20)[1]) * vol_mult
        int ext_idx = 2
        float min_l = low[2]
        
        for i = 2 to inv_lookback
            if low[i] <= min_l
                min_l := low[i]
                ext_idx := i
            if high[i] > high[1]
                break
                
        bool swp = false
        if ext_idx + 3 <= bar_index
            for j = 1 to 3
                if low[ext_idx + j] > low[ext_idx]
                    swp := true
                    break
        
        bool htf_aligned = (htf2_val == 1)
        bool has_vol = has_mom
        bool god_overlap = f_ob_has_god_fvg(high[0], low[0], true)
        bool is_discount = (hl2[1] < vwap_val[1])

        int ob_score = f_score_zone(swp, false, true, has_vol, is_discount, htf_aligned, god_overlap)
        string ob_medal = f_score_to_medal(ob_score, false)
        
        all_obs.unshift(ob_data.new(high[0], low[0], time[0], true, ob_score, ob_medal, false, false, 0, false, str.tostring(math.round(low[0], 5)), false, false, true, false))

    // --- BÚSQUEDA INVERSA BAJISTA ---
    if high[0] < low[2] and close[1] < open[1] and (low[2] - high[0]) > (atr_global * fvg_min_atr)
        bool has_mom = zDn[1] >= active_zThresh[1] or nz(volume[1]) > nz(ta.sma(volume, 20)[1]) * vol_mult
        int ext_idx = 2
        float max_h = high[2]
        
        for i = 2 to inv_lookback
            if high[i] >= max_h
                max_h := high[i]
                ext_idx := i
            if low[i] < low[1]
                break
                
        bool swp = false
        if ext_idx + 3 <= bar_index
            for j = 1 to 3
                if high[ext_idx + j] < high[ext_idx]
                    swp := true
                    break
        
        bool htf_aligned = (htf2_val == -1)
        bool has_vol = has_mom
        bool god_overlap = f_ob_has_god_fvg(high[0], low[0], false)
        bool is_premium = (hl2[1] > vwap_val[1])

        int ob_score = f_score_zone(swp, false, true, has_vol, is_premium, htf_aligned, god_overlap)
        string ob_medal = f_score_to_medal(ob_score, false)
        
        all_obs.unshift(ob_data.new(high[0], low[0], time[0], false, ob_score, ob_medal, false, false, 0, false, str.tostring(math.round(high[0], 5)), false, false, true, false))

// =========================================================================
// 10. MITIGACIONES Y BREAKERS
// =========================================================================
if array.size(all_obs) > 0
    for i = array.size(all_obs) - 1 to 0
        ob = array.get(all_obs, i)

        if ob.is_bull
            if close < ob.btm and body_strong
                if not ob.mitigated and (ob.score >= min_score or ob.is_choch_ob)
                    bool is_aligned = is_bias_off ? true : (active_trend <= 0 or crt_bias <= 0)
                    bool has_mom = zDn >= active_zThresh
                    if not strictBreaker or has_mom
                        if show_breaker and is_aligned
                            box bx = box.new(ob.loc_time, ob.top, time, ob.btm, bgcolor=color.new(color.orange, 90), border_color=color.new(color.orange, 50), border_style=line.style_dashed, text="♻️ Breaker", text_size=size.tiny, text_color=color.new(color.orange, 50))
                            array.push(ob_boxes_drawn, bx)
                        ob.mitigated := true
                        breaker_obs.unshift(ob)

                        if alert_zone_touch and in_kz
                            f_ia_alert("ZONE_BROKEN", syminfo.ticker, "TF: " + timeframe.period + " | Dir: SELL | Medal: " + f_short_medal(ob.medal) + " | Score: " + f_json_int(ob.score))
                
                array.remove(all_obs, i)
            else if low < ob.btm
                if not ob.partial_mitigated
                    ob.partial_mitigated := true
            else if low <= ob.top
                if not ob.mitigated and (ob.score >= min_score or ob.is_choch_ob)
                    ob.touch_count += 1
                    
                    // 🆕 v5.3: ZONE_TOUCHED alert — avisa a JARVIS cuando el precio toca una zona
                    if not ob.alerted_touch and ob.touch_count == 1 and alert_zone_touch and in_kz
                        ob.alerted_touch := true
                        bool is_premium = hl2 > vwap_val
                        string vwap_tag = (ob.is_bull and not is_premium) ? " | VWAP: DISCOUNT" : (not ob.is_bull and is_premium) ? " | VWAP: PREMIUM" : ""
                        f_ia_alert("ZONE_TOUCHED", syminfo.ticker, "TF: " + timeframe.period + " | Dir: " + (ob.is_bull ? "BUY" : "SELL") + " | Medal: " + f_short_medal(ob.medal) + " | Score: " + f_json_int(ob.score) + vwap_tag)
                    
                    if ob.touch_count >= max_touches
                        ob.mitigated := true
                        if show_breaker
                            box bx = box.new(ob.loc_time, ob.top, time, ob.btm, bgcolor=color.new(color.gray, 60), border_color=color.gray, border_style=line.style_dotted, text="Desgastado", text_size=size.tiny, text_color=color.gray)
                            array.push(ob_boxes_drawn, bx)
        else
            if close > ob.top and body_strong
                if not ob.mitigated and (ob.score >= min_score or ob.is_choch_ob)
                    bool is_aligned = is_bias_off ? true : (active_trend >= 0 or crt_bias >= 0)
                    bool has_mom = zUp >= active_zThresh
                    if not strictBreaker or has_mom
                        if show_breaker and is_aligned
                            box bx = box.new(ob.loc_time, ob.top, time, ob.btm, bgcolor=color.new(color.orange, 90), border_color=color.new(color.orange, 50), border_style=line.style_dashed, text="♻️ Breaker", text_size=size.tiny, text_color=color.new(color.orange, 50))
                            array.push(ob_boxes_drawn, bx)
                        ob.mitigated := true
                        breaker_obs.unshift(ob)

                        if alert_zone_touch and in_kz
                            f_ia_alert("ZONE_BROKEN", syminfo.ticker, "TF: " + timeframe.period + " | Dir: BUY | Medal: " + f_short_medal(ob.medal) + " | Score: " + f_json_int(ob.score))
                
                array.remove(all_obs, i)
            else if high > ob.top
                if not ob.partial_mitigated
                    ob.partial_mitigated := true
            else if high >= ob.btm
                if not ob.mitigated and (ob.score >= min_score or ob.is_choch_ob)
                    ob.touch_count += 1
                    
                    // 🆕 v5.3: ZONE_TOUCHED alert
                    if not ob.alerted_touch and ob.touch_count == 1 and alert_zone_touch and in_kz
                        ob.alerted_touch := true
                        bool is_premium = hl2 > vwap_val
                        string vwap_tag = (ob.is_bull and not is_premium) ? " | VWAP: DISCOUNT" : (not ob.is_bull and is_premium) ? " | VWAP: PREMIUM" : ""
                        f_ia_alert("ZONE_TOUCHED", syminfo.ticker, "TF: " + timeframe.period + " | Dir: " + (ob.is_bull ? "BUY" : "SELL") + " | Medal: " + f_short_medal(ob.medal) + " | Score: " + f_json_int(ob.score) + vwap_tag)
                    
                    if ob.touch_count >= max_touches
                        ob.mitigated := true
                        if show_breaker
                            box bx = box.new(ob.loc_time, ob.top, time, ob.btm, bgcolor=color.new(color.gray, 60), border_color=color.gray, border_style=line.style_dotted, text="Desgastado", text_size=size.tiny, text_color=color.gray)
                            array.push(ob_boxes_drawn, bx)

// =========================================================================
// 11. LIMPIEZA Y REFINAMIENTO
// =========================================================================
if array.size(all_obs) > max_active_obs
    removed = array.pop(all_obs)

if refine and array.size(all_obs) > 1
    for i = array.size(all_obs) - 1 to 1
        a = array.get(all_obs, i)
        for j = i - 1 to 0
            b = array.get(all_obs, j)
            if a.is_bull == b.is_bull
                if not (a.top < b.btm or a.btm > b.top)
                    // Zonas se solapan — quedarse con la de mayor score
                    if b.score >= a.score
                        a.hidden := true
                        break
                    else
                        b.hidden := true

while array.size(all_obs) > max_active_obs
    removed = array.pop(all_obs)

while array.size(breaker_obs) > 15
    array.pop(breaker_obs)

// =========================================================================
// 12. 🧮 RENDERIZADO Y DASHBOARD
// =========================================================================
if array.size(all_obs) > 0
    for i = 0 to array.size(all_obs) - 1
        ob = array.get(all_obs, i)
        if ob.hidden or ob.mitigated or ob.score < min_score
            continue
        
        bool should_show = (ob.medal == "Platino" and show_platino) or (ob.medal == "Oro" and show_oro) or (ob.medal == "Plata" and show_plata) or (ob.medal == "Bronce" and show_bronce) or (ob.medal == "CHoCH🚀" and show_choch)
        if not should_show
            continue

        color medal_c = ob.medal == "Platino" ? color.new(#9b59b6, 30) : ob.medal == "Oro" ? color.new(#f1c40f, 30) : ob.medal == "Plata" ? color.new(#bdc3c7, 30) : ob.medal == "CHoCH🚀" ? color.new(#ff5722, 30) : color.new(#cd853f, 30)

        box bx = box.new(ob.loc_time, ob.top, time, ob.btm, bgcolor=medal_c, border_color=ob.is_bull ? #089981 : #f23645, border_style=line.style_dashed, text=ob.medal, text_size=size.tiny, text_color=ob.is_bull ? #089981 : #f23645)
        array.push(ob_boxes_drawn, bx)

if array.size(breaker_obs) > 0
    for i = 0 to array.size(breaker_obs) - 1
        ob = array.get(breaker_obs, i)
        if ob.hidden
            continue
        box bx = box.new(ob.loc_time, ob.top, time, ob.btm, bgcolor=color.new(color.orange, 85), border_color=color.orange, border_style=line.style_dashed, text="♻️ Breaker", text_size=size.tiny, text_color=color.orange)
        array.push(ob_boxes_drawn, bx)

// =========================================================================
// 13. 📡 SISTEMA DE ALERTAS PARA JARVIS (PING PRICE + SYNC + HEARTBEAT)
// =========================================================================

// --- HEARTBEAT (Watchdog para Jarvis detectar desconexiones) ---
var int hb_counter = 0
hb_counter += 1
if use_heartbeat and barstate.isconfirmed and hb_counter >= 20
    hb_counter := 0
    string bias_str = bias_mode
    int zone_count = 0
    for i = 0 to array.size(all_obs) - 1
        ob = array.get(all_obs, i)
        if not ob.mitigated and not ob.hidden
            zone_count += 1
    
    f_ia_alert("HEARTBEAT", syminfo.ticker, "TF: " + timeframe.period + " | Bias: " + (crt_bias > 0 ? "BUY" : crt_bias < 0 ? "SELL" : "NEUTRAL") + " | Zones: " + str.tostring(zone_count) + " | VWAP: " + vwap_status)

// --- PING PRICE (Cada cierre de vela en 3M) ---
if use_ping and barstate.isconfirmed
    // 🆕 v5.3: PING incluye High/Low (mechas) para backtesting y SL
    f_ia_alert_freq("PING_PRICE", syminfo.ticker, "TF: " + timeframe.period + " | Precio: " + f_compact_price(close) + " | High: " + f_compact_price(high) + " | Low: " + f_compact_price(low) + " | VWAP: " + vwap_status + " | TS: " + str.tostring(time), alert.freq_all)

// --- SYNC ZONES (Mapa de zonas para Jarvis) ---
// 🆕 v5.3: Incluye tf, mid, atr. SL usa ATR buffer. tp usa null si no disponible.
var bool sync_has_divs = false
if use_sync and barstate.isconfirmed and in_kz
    string ob_json = ""
    int ob_count = 0
    
    for i = 0 to array.size(all_obs) - 1
        ob_res = array.get(all_obs, i)
        if ob_res.hidden or ob_res.mitigated
            continue
        
        if ob_count > 0
            ob_json += ","
        
        // 🆕 v5.3: SL con buffer ATR (0.5x ATR debajo del bottom para buys, encima del top para sells)
        string sl_str = ob_res.is_bull 
            ? f_json_float(ob_res.btm - atr_global * 0.5) 
            : f_json_float(ob_res.top + atr_global * 0.5)
        
        // 🆕 v5.3: TP usa null si no hay nivel disponible (JARVIS lo calcula con R:R)
        string tp_str = "null"
        
        // 🆕 v5.3: mid = punto medio de la zona
        string mid_str = f_json_float((ob_res.top + ob_res.btm) / 2.0)
        
        ob_json += '{"dir":"' + (ob_res.is_bull ? 'BUY' : 'SELL') + '","tf":"' + timeframe.period + '","top":' + f_json_float(ob_res.top) + ',"btm":' + f_json_float(ob_res.btm) + ',"mid":' + mid_str + ',"lvl":"' + ob_res.level + '","medal":"' + f_short_medal(ob_res.medal) + '","score":' + f_json_int(ob_res.score) + ',"tp":' + tp_str + ',"sl":' + sl_str + ',"atr":' + f_json_float(atr_global) + ',"d":"' + (ob_res.is_bull ? 'BUY' : 'SELL') + '","p":' + f_json_float(ob_res.top) + ',"b":' + f_json_float(ob_res.btm) + ',"mi":' + mid_str + ',"lv":"' + ob_res.level + '","md":"' + f_short_medal(ob_res.medal) + '","sc":' + f_json_int(ob_res.score) + ',"a":' + f_json_float(atr_global) + '}'
        
        ob_count += 1
    
    // 🆕 v5.3: Incluir divergencias activas en el JSON como zonas especiales
    if show_divs and array.size(active_divs) > 0
        for di = 0 to array.size(active_divs) - 1
            div = array.get(active_divs, di)
            if ob_count > 0
                ob_json += ","
            
            float div_top = div.is_bull ? div.top : div.top
            float div_btm = div.is_bull ? div.btm : div.btm
            float div_mid = (div_top + div_btm) / 2.0
            string div_sl = div.is_bull ? f_json_float(div_btm - atr_global * 0.5) : f_json_float(div_top + atr_global * 0.5)
            
            ob_json += '{"dir":"' + (div.is_bull ? 'BUY' : 'SELL') + '","tf":"' + timeframe.period + '","top":' + f_json_float(div_top) + ',"btm":' + f_json_float(div_btm) + ',"mid":' + f_json_float(div_mid) + ',"lvl":"DIV","medal":"SMC_DIV","score":4,"tp":null,"sl":' + div_sl + ',"atr":' + f_json_float(atr_global) + ',"d":"' + (div.is_bull ? 'BUY' : 'SELL') + '","p":' + f_json_float(div_top) + ',"b":' + f_json_float(div_btm) + ',"mi":' + f_json_float(div_mid) + ',"lv":"DIV","md":"SMC_DIV","sc":4,"a":' + f_json_float(atr_global) + '}'
            
            ob_count += 1
            sync_has_divs := true
    
    if ob_count > 0
        string trend_str = active_trend > 0 ? "BUY" : active_trend < 0 ? "SELL" : "NEUTRAL"
        string sync_msg = "TF: " + timeframe.period + " | Trend: " + trend_str + " | Predict IA: " + (crt_bias > 0 ? "BUY" : crt_bias < 0 ? "SELL" : "NEUTRAL") + " | VWAP: " + vwap_status + " | Payload: [" + ob_json + "]"
        f_ia_alert("SYNC_ZONES", syminfo.ticker, sync_msg)
