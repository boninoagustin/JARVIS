bool preset_3m     = tf_mode == "3M (Scalping Gatillo)"
bool preset_15m    = tf_mode == "15M (Estructura Intradía)"
bool preset_1h     = tf_mode == "1H (Zonas de Sesión)"
bool preset_4h     = tf_mode == "4H (Macro Ballenas)"

// Detectores del ADN (Controlan Filtros de Ruido, Z-Score y Cuerpos de vela)
bool is_fx     = asset_mode == "Forex (EURUSD / Movimientos Limpios)"
bool is_idx    = asset_mode == "Índices (US100 / Alta Volatilidad)"
