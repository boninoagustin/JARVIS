// ║    🔴 CRITICAL: Fixed tp/sl JSON fields (na guard) → now computes real SL  ║
// ║    🔴 CRITICAL: Added "tf" field inside JSON payload                       ║
// ║    🟠 HIGH:     ZONE_TOUCHED alerts for precise zone collision             ║
// ║    🟠 HIGH:     CHoCH vs BOS differentiated in alert prefix                ║
// ║    🟠 HIGH:     HEARTBEAT every 20 candles for watchdog                    ║
// ║    🟡 MEDIUM:   Divergences (SMC DIV) added to SYNC_ZONES payload          ║
// ║    🟡 MEDIUM:   SL calculated with ATR buffer (not zone edge)              ║
// ║    🟢 LOW:      PING uses alert.freq_all for multi-touch per candle        ║
// ║    🟢 LOW:      SYNC_ZONES throttled by barstate (only on new structure)   ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
indicator("SMC Master 5.1 [SMC Purist Engine]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=1000)

// =========================================================================
// 0. 🌟 PRESETS AUTOMÁTICOS (MATRIZ BIDIMENSIONAL)
// =========================================================================
grp_presets = "🌟 PERFIL DE ROL Y ADN DEL ACTIVO"

tf_mode = input.string("3M (Scalping Gatillo)", "1. Rol del Gráfico (Temporalidad)", options=["Manual (Usar Configuración Abajo)", "3M (Scalping Gatillo)", "15M (Estructura Intradía)", "1H (Zonas de Sesión)", "4H (Macro Ballenas)"], group=grp_presets)

asset_mode = input.string("Forex (EURUSD / Movimientos Limpios)", "2. ADN del Activo (Volatilidad)", options=["Forex (EURUSD / Movimientos Limpios)", "Índices (US100 / Alta Volatilidad)", "Crypto (BTC / Mercado 24-7)"], group=grp_presets)

// Detectores del Rol (Controlan Pings, Alertas y Tolerancia a toques)
