in_alert_zone_touch = input.bool(true, "5. Alerta: Toque Zona Específica (ZONE_TOUCHED)", group=grp_alerts)
alert_zone_touch    = preset_3m ? true : preset_15m ? true : preset_1h ? false : preset_4h ? false : in_alert_zone_touch

grp_radar = "📡 Radar Biónico (Conexión JARVIS JSON)"
in_sync_strict = input.bool(false, "Sincronización Estricta (Solo a favor de Macro)", group=grp_radar)
sync_strict    = preset_3m ? false : preset_15m ? false : preset_1h ? false : preset_4h ? false : in_sync_strict

in_use_sync = input.bool(true, "Sincronizar Zonas (cada killzone)", group=grp_radar)
use_sync    = preset_3m ? false : preset_15m ? true : preset_1h ? true : preset_4h ? true : in_use_sync 

in_use_ping = input.bool(true, "Enviar PING de Precio al cerrar vela", group=grp_radar)
use_ping    = preset_3m ? true : preset_15m ? false : preset_1h ? false : preset_4h ? false : in_use_ping

