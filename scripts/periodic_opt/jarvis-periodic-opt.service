[Unit]
Description=JARVIS Centro de Optimización Periódica — hyperopt semanal + comparación producción (solo propone, nunca aplica)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/JARVIS
ExecStart=/usr/bin/python3 /opt/JARVIS/scripts/periodic_opt/run_weekly.py
ExecStartPost=/root/.nvm/versions/node/v24.19.0/bin/npx tsx /opt/JARVIS/scripts/periodic_opt/push_reports.js
# 🩺 Health-check (sello de calidad): corre SIEMPRE al final (prefijo -), valida que el
# sistema quedó sano tras toda la maquinaria del domingo. Escribe a health_check/latest
# (el panel de Optimización Periódica lo muestra). No muta configs ni journal.
ExecStartPost=-/root/.nvm/versions/node/v24.19.0/bin/npx tsx /opt/JARVIS/scripts/health_check.ts
# node/npx en PATH para el worker del hyperopt (venv python lo invoca)
Environment=PATH=/root/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
Nice=5
# Guardrails anti-OOM: si el job se dispara de memoria, systemd lo mata a ÉL,
# no a la máquina (el bot sigue vivo). 8GB total: el job se limita a 4-5GB.
MemoryHigh=4G
MemoryMax=5G
# F3-etapa2: 400 trials × 28 dims por activo ≈ 21 min/activo; 10 activos + refresh + sweeps ≈ 5-6h.
# Peor caso (algún ticker al timeout de 75 min): 12h cubren.
TimeoutStartSec=12h

[Install]
WantedBy=multi-user.target
