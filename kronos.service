[Unit]
Description=Kronos AI FastAPI Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agustinbonino
WorkingDirectory=/home/agustinbonino/Descargas/JARVIS/kronos_api
Environment=PATH=/home/agustinbonino/Descargas/JARVIS/kronos_api/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/agustinbonino/Descargas/JARVIS/kronos_api/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
