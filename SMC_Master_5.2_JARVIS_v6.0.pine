// SMC Master 5.2 [JARVIS v6.0] — Generado el 01/07/2026
// 🆕 v6.0: 7 mejoras estructurales basadas en auditoría técnica
//@version=5

indicator("SMC Master 5.2 [JARVIS v6.0]", overlay=true, max_boxes_count=80, max_lines_count=50, max_labels_count=50, max_bars_back=300)

// =========================================================================
// 0. 🌟 PRESETS AUTOMÁTICOS (MATRIZ BIDIMENSIONAL INTELIGENTE)
// =========================================================================
grp_presets = "🌟 PERFIL DE ROL Y ADN DEL ACTIVO"

preset_opt = input.string("Forex - 3. Balanceado", "Preset Estratégico", options=[
  "Manual (Usar Configuración Abajo)", 
  "Forex - 1. Ultra Conservador", "Forex - 2. Conservador", "Forex - 3. Balanceado", "Forex - 4. Agresivo", "Forex - 5. Ultra Agresivo",
  "Índices - 1. Ultra Conservador", "Índices - 2. Conservador", "Índices - 3. Balanceado", "Índices - 4. Agresivo", "Índices - 5. Ultra Agresivo",
  "Crypto - 1. Ultra Conservador", "Crypto - 2. Conservador", "Crypto - 3. Balanceado", "Crypto - 4. Agresivo", "Crypto - 5. Ultra Agresivo"], group=grp_presets)

// 🤖 AUTO-DETECCIÓN DE TEMPORALIDAD
bool auto_5m  = timeframe.isintraday and timeframe.multiplier <= 5
bool auto_15m = timeframe.isintraday and timeframe.multiplier > 5 and timeframe.multiplier <= 30
bool auto_1h  = timeframe.isintraday and timeframe.multiplier > 30 and timeframe.multiplier <= 120
bool auto_4h  = timeframe.isintraday and timeframe.multiplier > 120
bool auto_D   = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly

// Determinar Activo según Preset
bool preset_manual = preset_opt == "Manual (Usar Configuración Abajo)"
bool is_fx = str.contains(preset_opt, "Forex")
bool is_idx = str.contains(preset_opt, "Índices")
bool is_crypto = str.contains(preset_opt, "Crypto")

if preset_manual
    is_crypto := syminfo.type == "crypto"
    is_idx := syminfo.type == "index" or syminfo.type == "stock"
    is_fx := syminfo.type == "forex" or (not is_crypto and not is_idx)

// Niveles de Riesgo (1: Ultra Cons, 5: Ultra Agre)
int risk_lvl = 3
if str.contains(preset_opt, "1. Ultra Conservador")
    risk_lvl := 1
else if str.contains(preset_opt, "2. Conservador")
    risk_lvl := 2
else if str.contains(preset_opt, "3. Balanceado")
    risk_lvl := 3
else if str.contains(preset_opt, "4. Agresivo")
    risk_lvl := 4
else if str.contains(preset_opt, "5. Ultra Agresivo")
    risk_lvl := 5

// =========================================================================
// 1. ⚖️ DIRECCIÓN Y SESGO MACRO (BIAS)
// =========================================================================
grp_htf = "⚖️ HUD Scalper (PO3 & Estructura)"
bias_mode = input.string("Automático (Daily Open Direccional)", "Modo Bias de Sesión", options=["Automático (Daily Open Direccional)", "Manual Alcista 🟢", "Manual Bajista 🔴", "Desactivado (Mostrar Todos)"], group=grp_htf)

bool override_choch = true
bool filter_obs     = false
bool use_scalp      = true

// =========================================================================
// 2. 👁️ VISIBILIDAD EN GRÁFICO (DASHBOARD)
// =========================================================================
grp_show = "👁️ Visibilidad de Zonas (Filtros)"
in_min_score = input.int(3, "Score Mínimo para Mostrar", minval=0, maxval=10, group=grp_show)
int base_sc = auto_5m ? 2 : auto_15m ? 3 : auto_1h ? 3 : auto_4h ? 3 : 3
int dyn_min_score = math.max(0, math.min(10, base_sc + (3 - risk_lvl)))
min_score = preset_manual ? in_min_score : dyn_min_score

show_platino = input.bool(true, "Mostrar 🟣 Platino (Score 9-10)", group=grp_show)
show_oro     = input.bool(true, "Mostrar 🟡 Oro (Score 7-8)", group=grp_show)
show_plata   = input.bool(true, "Mostrar ⚪ Plata (Score 5-6)", group=grp_show)

in_show_bronce = input.bool(false,"Mostrar 🟤 Bronce (Score 3-4)", group=grp_show)
show_bronce    = preset_manual ? in_show_bronce : risk_lvl >= 3

show_choch   = input.bool(true, "Mostrar 🚀 CHoCH OB (Gatillo)", group=grp_show)
show_god     = input.bool(true, "Mostrar 💎 GOD ZONE (Confluencia iFVG)", group=grp_show)
show_breaker = input.bool(true, "Mostrar ♻️ Breakers", group=grp_show)
show_divs    = input.bool(true, "Mostrar ⚡ Divergencias en SYNC", group=grp_show)

// =========================================================================
// 3. 🏛️ MOTORES DE ORDER BLOCKS (CORE)
// =========================================================================
grp_vis  = "🏛️ Order Blocks (SMC Purist)"
refine   = input.bool(true, "Refinar Zonas (Jerarquía Institucional)", group=grp_vis)
require_displacement = input.bool(true, "Exigir Desplazamiento + BOS posterior (SMC Purist)", group=grp_vis)

in_require_fvg_after_ob = input.bool(true, "Exigir FVG en las 3 velas siguientes al OB", group=grp_vis)
require_fvg_after_ob    = preset_manual ? in_require_fvg_after_ob : risk_lvl <= 2 

strictBreaker = input.bool(true, "Breakers Estrictos (Exige Volumen)", group=grp_vis)

in_strictSweep = input.bool(true, "Exigir Sweep previo estricto para OBs", group=grp_vis)
strictSweep    = preset_manual ? in_strictSweep : risk_lvl <= 2 

// 🆕 v6.0: MEJORA #5 — Confirmación de cierre para CHoCH/BOS (evita repainting)
in_confirm_close = input.bool(true, "Confirmar CHoCH/BOS con cierre de vela (anti-repainting)", group=grp_vis)
confirm_close    = preset_manual ? in_confirm_close : true

// 🆕 v6.0: MEJORA #4 — Fusión inteligente de OBs adyacentes
in_merge_obs = input.bool(true, "Fusionar OBs adyacentes en zonas compuestas", group=grp_vis)
merge_obs    = preset_manual ? in_merge_obs : true
merge_tolerance = input.float(0.3, "Tolerancia fusión OBs (x ATR)", step=0.05, minval=0.1, maxval=2.0, group=grp_vis)

in_max_active_obs = input.int(20, "Máximo OBs Activos (Performance)", minval=10, maxval=100, group=grp_vis)
int dyn_max_obs   = auto_5m ? 30 : auto_15m ? 12 : auto_1h ? 8 : auto_4h ? 6 : 4
max_active_obs    = preset_manual ? in_max_active_obs : dyn_max_obs 

prox_atr    = input.float(0.5, "Distancia Mínima OBs (x ATR)", step=0.1, group=grp_vis)
