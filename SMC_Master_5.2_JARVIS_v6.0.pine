grp_str = "🔨 Estructura y Sweeps"
showBos         = input.bool(true, "Mostrar BOS / CHoCH", group=grp_str)

in_str_bars = input.int(8, "Sensibilidad BOS (Micro)", group=grp_str)
int dyn_str_bars = auto_5m ? 6 : auto_15m ? 6 : auto_1h ? 8 : auto_4h ? 10 : 12
if not preset_manual
