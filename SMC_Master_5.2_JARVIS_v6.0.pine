str_bars    = preset_manual ? in_str_bars : math.max(3, dyn_str_bars) 

require_body_break = input.bool(true, "CHoCH/BOS exige cierre con cuerpo (no solo wick)", group=grp_str)

in_choch_req_sweep = input.bool(false, "CHoCH Estricto: Exigir Sweep Previo (Manual)", group=grp_str)
bool auto_sweep = not preset_manual ? (risk_lvl <= 2 or (auto_1h or auto_4h or auto_D)) : (auto_1h or auto_4h or auto_D)
choch_req_sweep = preset_manual ? in_choch_req_sweep : auto_sweep

in_choch_req_mom   = input.bool(false, "CHoCH Estricto: Exigir Volumen/Momentum", group=grp_str)
choch_req_mom      = preset_manual ? in_choch_req_mom : (risk_lvl == 1 or auto_4h or auto_D)

showSweep       = input.bool(true, "Mostrar Etiquetas CRT / Sweeps", group=grp_str)

// 🆕 v6.0: MEJORA #2 — Detección de Liquidity Grab (falsas rupturas con mecha)
grp_liq_grab = "🩸 Liquidity Grab (Falsas Rupturas)"
