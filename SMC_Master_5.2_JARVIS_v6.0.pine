grp_fvg = "🕳️ Filtros Pro FVG / iFVG"
show_fvg     = input.bool(true, "Mostrar FVG Normales", group=grp_fvg)
showIfvg     = input.bool(true, "Mostrar iFVG (Inversión)", group=grp_fvg)
fvg_min_atr  = input.float(0.2, "Mínimo Tamaño FVG (x ATR)", step=0.1, group=grp_fvg)
fvg_max_atr  = input.float(4.0, "Máximo Tamaño FVG (x ATR)", step=0.5, group=grp_fvg)

