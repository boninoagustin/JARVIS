if not preset_manual
    dyn_ob_min_body := dyn_ob_min_body + ((3 - risk_lvl) * 0.05)
ob_min_body    = preset_manual ? in_ob_min_body : dyn_ob_min_body

in_displ_atr_mult = input.float(1.0, "Tamaño Mínimo Vela Desplazamiento (x ATR)", step=0.1, group=grp_vis)
float dyn_displ = is_idx ? 0.8 : is_crypto ? 0.7 : 0.5
if not preset_manual
    dyn_displ := dyn_displ + ((3 - risk_lvl) * 0.1)
displ_atr_mult    = preset_manual ? in_displ_atr_mult : dyn_displ 

vol_mult = input.float(2.5, "Mult. Volumen (Score)", step=0.1, group=grp_vis)

in_max_touches = input.int(3, "Máximo Toques antes de Degradar OB", minval=1, maxval=10, group=grp_vis)
int dyn_max_touches = auto_5m ? 3 : auto_15m ? 4 : auto_1h ? 3 : auto_4h ? 2 : 2
max_touches    = preset_manual ? in_max_touches : dyn_max_touches 

grp_legacy = "🏃‍♂️ Motor Scalping (Legacy 4.7)"
in_use_inv_motor = input.bool(true, "Activar Búsqueda Inversa (FVG Origin)", group=grp_legacy)
// 🆕 v6.0: MEJORA #7 — Motor Legacy ahora requiere sweep de liquidez para crear OBs en TFs bajas
use_inv_motor    = preset_manual ? in_use_inv_motor : (auto_5m or auto_15m)
in_inv_req_sweep = input.bool(true, "🆕 Exigir Sweep en Motor Legacy (reduce falsos)", group=grp_legacy)
inv_req_sweep    = preset_manual ? in_inv_req_sweep : (auto_5m or auto_15m)

inv_lookback  = input.int(20, "Ventana Búsqueda Inversa (Velas)", group=grp_legacy)
vwap_boost    = input.int(3, "Bonus Puntos por Toque VWAP", group=grp_legacy)

